{
  "info": {
    "name": "Шарай ПЗ4 — Kafka HAProxy RabbitMQ",
    "description": "Вахрушев И.А., 25-КМ-ИБ2. ВМ sharay-messaging, Producer 8020, Consumer 8021. Сначала запустить Docker Compose, затем выполнить всю коллекцию по порядку.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "producer",
      "value": "http://127.0.0.1:8020"
    },
    {
      "key": "consumer",
      "value": "http://127.0.0.1:8021"
    }
  ],
  "item": [
    {
      "name": "01 Producer health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{producer}}/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"run_id\", \"postman-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Producer работает через HAProxy\", () => pm.expect(pm.response.json().kafka_bootstrap_servers).to.eql(\"haproxy:9093\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Consumer health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{consumer}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Consumer healthy\", () => pm.expect(pm.response.json().status).to.eql(\"healthy\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Kafka send orders",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{producer}}/orders/?run_id={{run_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": 1,\n  \"user_id\": 100,\n  \"product\": \"Laptop\",\n  \"quantity\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Сообщение принято брокером\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Kafka send notifications",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
