    {
      "name": "09 Kafka received orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{consumer}}/orders/"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(() => {}, 1800);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const expected = {\"order_id\": 1, \"user_id\": 100, \"product\": \"Laptop\", \"quantity\": 1};",
              "pm.test(\"Получены переданные данные\", () => pm.expect(pm.response.json().orders.some(row => Object.keys(expected).every(key => row[key] === expected[key]))).to.be.true);"
            ]
          }
        }
      ]
    },
