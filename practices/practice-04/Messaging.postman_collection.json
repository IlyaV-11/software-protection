          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Все 6 сообщений обработаны\", () => pm.expect(pm.response.json().count).to.eql(6));",
              "pm.test(\"Оба брокера присутствуют\", () => pm.expect([...new Set(pm.response.json().events.map(e => e.transport))].sort()).to.eql([\"kafka\", \"rabbitmq\"]));"
            ]
